#!/usr/bin/env bash
# Install the global skills this setup uses (into ~/.agents/skills), then update them.
# Skills tracked in this repo under skills/ are not managed here.
# Also unmanaged: pstack picks hand-adapted for Pi in ~/.agents/skills
# (unslop, blast-radius, create-verification-skill, maintain-verification-skill),
# copied from github.com/cursor/plugins/tree/main/pstack (MIT).
set -euo pipefail

install() {
  local source=$1
  shift
  npx --yes skills add "$source" --global --agent pi --skill "$@" --yes
}

install mattpocock/skills \
  ask-matt code-review codebase-design diagnosing-bugs domain-modeling \
  grill-with-docs handoff implement improve-codebase-architecture pr \
  prototype research retro setup-matt-pocock-skills tdd to-spec \
  to-tickets wait-what wayfinder wizard writing-for-agents

npx --yes skills update --global --yes
printf 'Skills installed and updated.\n'
