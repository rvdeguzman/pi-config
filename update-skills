#!/usr/bin/env bash
# Install the global skills this setup uses (into ~/.agents/skills), then update them.
# Skills tracked in this repo under skills/ are not managed here.
set -euo pipefail

install() {
  local source=$1
  shift
  npx --yes skills add "$source" --global --agent pi --skill "$@" --yes
}

install mattpocock/skills \
  ask-matt claude-handoff code-review codebase-design diagnosing-bugs \
  domain-modeling handoff implement implement-spec \
  improve-codebase-architecture loop-me prototype research \
  resolving-merge-conflicts retro setup-matt-pocock-skills \
  setup-ts-deep-modules tdd teach to-questionnaire to-spec to-tickets \
  triage wayfinder wizard writing-beats writing-for-agents \
  writing-fragments writing-shape

npx --yes skills update --global --yes
printf 'Skills installed and updated.\n'
