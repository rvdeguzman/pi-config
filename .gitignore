# This repo is checked out directly at ~/.pi/agent. Whitelist the authored
# config; everything else there is machine state (auth, sessions, caches).
/*
!/.gitignore
!/Makefile
!/README.md
!/settings.example.json
!/AGENTS.md
!/SUBAGENT-SPEC.md
!/EULER-SPEC.md
!/ASK-QUESTION-SPEC.md
!/BTW-SPEC.md
!/update-skills
!/skills
!/extensions
!/agents
!/prompts
!/scripts
node_modules/
agents/.glla-subagent-sync.json
